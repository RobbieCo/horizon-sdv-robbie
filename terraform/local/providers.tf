# Description:
# Providers point at the developer's desktop Kubernetes via the local kubeconfig
# context (rancher-desktop / docker-desktop). deploy.sh --local verifies the
# context before Terraform runs; these providers do not talk to GCP.

provider "kubernetes" {
  config_path    = var.kubeconfig_path
  config_context = var.kube_context
}

provider "helm" {
  kubernetes = {
    config_path    = var.kubeconfig_path
    config_context = var.kube_context
  }
}

provider "kubectl" {
  config_path      = var.kubeconfig_path
  config_context   = var.kube_context
  load_config_file = true
}

provider "tls" {}

provider "random" {}
